+esp_err_t app_audio_player_mem_if_idle(const uint8_t *p_buf, size_t len)
+{
+    struct app_audio_player *player = gp_audio_player;
+    if (player == NULL || p_buf == NULL || len == 0) return ESP_ERR_INVALID_STATE;
+    FILE *fp = fmemopen((void *)p_buf, len, "rb");
+    if (fp == NULL) return ESP_ERR_NO_MEM;
+    /* Serialize the final idle check with file/memory enqueue operations. */
+    __data_lock(player);
+    esp_err_t result = ESP_ERR_INVALID_STATE;
+    if (player->status == AUDIO_PLAYER_STATUS_IDLE && audio_player_get_state() == AUDIO_PLAYER_STATE_IDLE) {
+        result = audio_player_play(fp);
+        if (result == ESP_OK) {
+            player->status = AUDIO_PLAYER_STATUS_PLAYING_MEM;
+            player->mem_need_free = false;
+            player->p_mem_buf = (void *)p_buf;
+        }
+    }
+    __data_unlock(player);
+    if (result != ESP_OK) fclose(fp);
+    return result;
 }
 
 esp_err_t app_audio_player_mem_block(uint8_t *p_buf, size_t len, bool is_need_free, TickType_t xTicksToWait)
